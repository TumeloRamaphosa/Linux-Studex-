# Copy to .env.local. Never commit real keys.

# Data source: "sample" (default), "denchclaw" or "sheets-csv"
DATA_SOURCE=sample

# DenchClaw (OpenClaw fork) - web UI/API on :3200 once installed
DENCHCLAW_URL=http://localhost:3200
DENCHCLAW_TOKEN=

# Published-to-web CSV export of the nightly Google Sheet (optional)
SHEETS_CSV_URL=

# Service health checks (name|url pairs separated by commas)
HEALTH_TARGETS=DenchClaw|http://localhost:3200,Paperclip AI|http://localhost:3100,Picoclaw gateway|http://localhost:18790,MCPJungle|http://localhost:8080/health,MiroFish|http://192.168.1.114:3000,Ollama|http://192.168.1.114:11434

# CashClaw Guard state file (JSON). Optional.
GUARD_STATE_PATH=
